{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/v/:id",
      "destination": "/api/v?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/no",
      "destination": "/",
      "permanent": true
    }
  ]
}
